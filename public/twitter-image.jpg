<svg width="1200" height="675" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a0f1f;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#3d0000;stop-opacity:1" />
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#bgGradient)"/>
  
  <!-- Game Logo -->
  <text x="600" y="300" font-family="MedievalSharp" font-size="64" 
        fill="#ffffff" text-anchor="middle" filter="url(#glow)">
    Crypt of Greed
  </text>
  
  <!-- Twitter Handle -->
  <text x="600" y="400" font-family="Geist" font-size="32" 
        fill="#cccccc" text-anchor="middle">
    @cryptofgreed
  </text>
</svg>