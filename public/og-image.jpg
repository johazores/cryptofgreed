<svg width="1200" height="630" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a0f1f;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#3d0000;stop-opacity:1" />
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#bgGradient)"/>
  
  <!-- Decorative Pattern -->
  <path d="M0 0h1200v630H0z" fill="#000" fill-opacity="0.1" 
        stroke="#8a0000" stroke-width="8" stroke-dasharray="20,10"/>
  
  <!-- Title -->
  <text x="600" y="250" font-family="MedievalSharp" font-size="72" 
        fill="#ffffff" text-anchor="middle" filter="url(#glow)">
    Crypt of Greed
  </text>
  
  <!-- Subtitle -->
  <text x="600" y="350" font-family="Geist" font-size="36" 
        fill="#cccccc" text-anchor="middle">
    NFT Roguelike Card Game
  </text>
  
  <!-- Core DAO Logo -->
  <text x="600" y="450" font-family="Geist" font-size="24" 
        fill="#8a0000" text-anchor="middle">
    Powered by Core DAO
  </text>
</svg>