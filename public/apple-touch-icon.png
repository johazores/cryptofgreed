<svg width="180" height="180" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="appIconGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8a0000;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#3d0000;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="180" height="180" rx="45" fill="url(#appIconGradient)"/>
  
  <!-- Stylized Logo -->
  <text x="90" y="110" font-family="MedievalSharp" font-size="120" 
        fill="#ffffff" text-anchor="middle">
    C
  </text>
</svg>