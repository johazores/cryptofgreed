datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String      @id @default(auto()) @map("_id") @db.ObjectId
  email                  String      @unique
  password               String
  role                   String      @default("USER")
  name                   String?
  walletAddress          String?
  custodialWalletAddress String?             // Legacy only; new accounts do not receive custodial wallets
  encryptedPrivateKey    String?             // Legacy only; no new private keys are stored
  crystals               Int         @default(0)
  bankItems              BankItem[]
  characters             Character[]
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model Character {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String         @unique
  class         FightingStyle
  gold          Int            @default(0)
  currentHealth Int            @default(100)
  maxHealth     Int            @default(100)
  energy        Int            @default(3)
  monstersSlain Int            @default(0)
  isDead        Boolean        @default(false)
  experience    Int            @default(0)
  level         Int            @default(1)
  floor         Int            @default(1)
  equipment     Equipment[]
  powers        Power[]
  user          User           @relation(fields: [userId], references: [id])
  userId        String         @db.ObjectId
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum FightingStyle {
  MELEE
  RANGE
  MAGIC
}

model Equipment {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String
  slot            EquipmentSlot
  tier            ItemTier
  stats           Json
  contractAddress String?        // Legacy NFT reference; normal shop items do not use it
  nftId           String?        // Legacy NFT reference; normal shop items do not use it
  character       Character?     @relation(fields: [characterId], references: [id])
  characterId     String?        @db.ObjectId
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model BankItem {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String
  slot            EquipmentSlot
  tier            ItemTier
  contractAddress String
  stats           Json
  nftId           String
  user            User          @relation(fields: [userId], references: [id])
  userId          String        @db.ObjectId
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Power {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  effect      Json
  character   Character @relation(fields: [characterId], references: [id])
  characterId String    @db.ObjectId
  createdAt   DateTime  @default(now())
}

enum EquipmentSlot {
  HELMET
  ARMOR
  BOOTS
  WEAPON
}

enum ItemTier {
  T0
  T1
  T2
  T3
  T4
  T5
}
